# --- Terraform -------------------------------------------------------------
# Provider plugins and module cache (recreated by `terraform init`)
**/.terraform/*

# State files contain resource IDs and can contain secrets; never commit them
*.tfstate
*.tfstate.*

# Saved plan files
*.tfplan
tfplan

# Crash logs
crash.log
crash.*.log

# Variable files hold subscription/tenant/object IDs; only the example is tracked
*.tfvars
*.tfvars.json
!*.tfvars.example

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc

# NOTE: .terraform.lock.hcl is intentionally tracked (pins provider checksums)

# --- Kubernetes ------------------------------------------------------------
kubeconfig
*.kubeconfig

# --- Editor / OS -----------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db
